NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Necesaria solo para "Nueva cita por dictado" (interpretar texto/voz con IA).
# Se crea en https://console.anthropic.com (API Keys). Sin esta variable, el resto
# de la app funciona igual; solo esa pantalla concreta dará un aviso.
# ANTHROPIC_API_KEY=

# Solo para previsualizar la app en local SIN un proyecto Supabase todavía:
# login y datos falsos en memoria (ver src/lib/dev/). Nunca se activa en producción
# aunque se deje puesta. Con esto activo no hacen falta las dos variables de arriba.
# DEV_FAKE_BACKEND=true
